1 VERSIONINFO
FILEVERSION @SLIC3R_RC_VERSION@
PRODUCTVERSION @SLIC3R_RC_VERSION@
{
 BLOCK "StringFileInfo"
 {
  BLOCK "040904E4"
  {
   VALUE "CompanyName", "@SLIC3R_APP_NAME@"
   VALUE "FileDescription", "@SLIC3R_APP_NAME@"
   VALUE "FileVersion", "@SLIC3R_BUILD_ID@"
   VALUE "ProductName", "@SLIC3R_APP_NAME@"
   VALUE "ProductVersion", "@SLIC3R_BUILD_ID@"
   VALUE "InternalName", "@SLIC3R_APP_NAME@"
   VALUE "LegalCopyright", "Copyright (C) 2024-2026 the @SLIC3R_APP_NAME@ contributors. All rights reserved."
   VALUE "OriginalFilename", "EdgeSlicer.exe"
  }
 }
 BLOCK "VarFileInfo"
 {
   VALUE "Translation", 0x409, 1252
 }
}
2 ICON "@SLIC3R_RESOURCES_DIR@/images/EdgeSlicer.ico"
1 24 "Snapmaker_Orca.manifest" 
